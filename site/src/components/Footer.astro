---
import { Image } from 'astro:assets';
import photo from '../assets/matthias_koenig.webp';
interface Props { fetchedAt: string }
const date = new Date(Astro.props.fetchedAt).toISOString().slice(0, 10);

// Inline icons (no icon font): [title, href, svg path(s) in a 24x24 viewBox]
const social: [string, string, string][] = [
  ['Curriculum vitae', 'https://livermetabolism.com/cv/', 'M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-4.4 0-8 2.2-8 5v3h16v-3c0-2.8-3.6-5-8-5Z'],
  ['GitHub', 'https://github.com/matthiaskoenig', 'M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.4-1.1-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.2-4.6-1.1-4.6-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.5 9.5 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.8-2.3 4.7-4.6 4.9.4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2Z'],
  ['Google Scholar', 'https://scholar.google.com/citations?user=xD9IjnYAAAAJ&hl=en', 'M12 3 1 10l4 2.4V17l7 4 7-4v-4.6l1.5-.9V17H22v-7L12 3Zm0 2.4L18.6 10 12 14 5.4 10 12 5.4Zm-5 8.1 5 3 5-3v2.3l-5 2.9-5-2.9v-2.3Z'],
  ['ORCID', 'https://orcid.org/0000-0003-1725-179X', 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20ZM8.3 6.4a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Zm-.7 3h1.5v8H7.6v-8Zm3.4 0h3.6c3.4 0 4.9 2.4 4.9 4s-1.5 4-4.9 4H11v-8Zm1.5 1.4v5.2h2c2.4 0 3.4-1.5 3.4-2.6s-1-2.6-3.4-2.6h-2Z'],
