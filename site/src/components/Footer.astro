---
<footer class="mt-auto bg-surface py-8 text-sm text-ink/80">
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
      <Image src={photo} alt="Matthias König" width={96} height={96} class="h-12 w-12 rounded-full object-cover" />
      <div class="min-w-[200px] flex-1">
        <h2 class="font-display text-base font-bold uppercase tracking-wide text-primary">Systems Medicine, Digital Twins &amp; AI</h2>
        <p class="mt-0.5"><strong>Prof. Dr. rer. nat. Matthias König</strong> · Professor of Metabolic Inflammation and Carcinogenesis of the Liver</p>
      </div>
      <ul class="flex flex-wrap gap-2">
        {social.map(([title, href, d]) => (
          <li>
            <a class="flex h-9 w-9 items-center justify-center rounded-full bg-white text-primary shadow-sm hover:bg-accent hover:text-white" href={href} title={title} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true"><path d={d} /></svg>
              <span class="sr-only">{title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <p>
        <strong>Lübeck</strong> · University Hospital Schleswig-Holstein, Campus Lübeck, First Department of Medicine,
        Ratzeburger Allee 160, 23562 Lübeck, Germany ·
        <a class="text-accent underline" href="mailto:konigmatt@googlemail.com">konigmatt@googlemail.com</a> · +49 451 3101-7845
      </p>
      <p>
        <strong>Berlin</strong> · Institute for Biology, ITB, Humboldt-Universität zu Berlin, Philippstraße 13, 10115 Berlin, Germany ·
        <a class="text-accent underline" href="mailto:koenigmx@hu-berlin.de">koenigmx@hu-berlin.de</a> · +49 30 2093-98435
      </p>
    </div>

    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 border-t border-white pt-4 text-ink/60">
      <span>© 2016–{new Date().getFullYear()} Matthias König</span>
      <a class="hover:text-accent" href="/impressum/">Imprint &amp; privacy</a>
      <a class="hover:text-accent" href="https://github.com/matthiaskoenig/matthiaskoenig">Site source</a>
      <span class="ml-auto">GitHub data fetched on {date}</span>
    </div>
  </div>
</footer>
