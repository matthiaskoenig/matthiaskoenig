---
import type { ProjectView } from '../lib/merge.ts';
interface Props { project: ProjectView }
const { project: p } = Astro.props;
const fmt = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
const pyVersions = p.meta?.pythonVersions ?? [];
const python =
  pyVersions.length > 1 ? `Python ${pyVersions[0]}–${pyVersions[pyVersions.length - 1]}`
  : pyVersions.length === 1 ? `Python ${pyVersions[0]}`
  : p.meta?.requiresPython ? `Python ${p.meta.requiresPython}`
  : null;
const license = p.repo.license ?? p.meta?.license ?? null;
// Zenodo DOI from the repository, else the curated one if it is a Zenodo DOI; other curated DOIs are papers.
const curatedIsZenodo = !!p.doi && p.doi.startsWith('10.5281/zenodo.');
const zenodo = p.meta?.zenodoDoi ?? (curatedIsZenodo ? p.doi! : null);
const paperDoi = p.doi && !curatedIsZenodo ? p.doi : null;
---
<article class="flex flex-col rounded-lg border border-surface bg-white p-5 shadow-sm">
  <h3 class="text-xl"><a class="hover:text-accent" href={p.repo.htmlUrl}>{p.name}</a></h3>
  <p class="text-sm text-muted">{p.title}</p>
  <p class="mt-3 flex-1 text-ink/80">{p.description}</p>
  <ul class="mt-3 flex flex-wrap gap-2 text-xs">
    {p.tags.map((t) => <li class="rounded-full bg-surface px-2 py-0.5">{t}</li>)}
  </ul>
  <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm text-ink/70">
    <dt class="text-muted">Latest release</dt>
    <dd>{p.latestRelease ? <a class="hover:text-accent" href={p.latestRelease.htmlUrl}>{p.latestRelease.tag}</a> : '—'}{p.latestRelease && <span class="text-muted"> · {fmt(p.latestRelease.publishedAt)}</span>}</dd>
    <dt class="text-muted">Language</dt>
    <dd>{p.repo.language ?? '—'}{python && <span> · {python}</span>}</dd>
    <dt class="text-muted">License</dt>
    <dd>{license ?? '—'}</dd>
    <dt class="text-muted">Activity</dt>
    <dd>★ {p.repo.stars} · ⑂ {p.repo.forks} · updated {fmt(p.repo.pushedAt)}</dd>
  </dl>
  <ul class="mt-3 flex flex-wrap gap-3 text-sm">
    <li><a class="text-accent underline" href={p.repo.htmlUrl}>Repository</a></li>
    {p.docs && <li><a class="text-accent underline" href={p.docs}>Documentation</a></li>}
    {p.homepage && <li><a class="text-accent underline" href={p.homepage}>Website</a></li>}
    {zenodo && <li><a class="text-accent underline" href={`https://doi.org/${zenodo}`} title={zenodo}>Zenodo</a></li>}
    {paperDoi && <li><a class="text-accent underline" href={`https://doi.org/${paperDoi}`} title={paperDoi}>Paper DOI</a></li>}
  </ul>
</article>
