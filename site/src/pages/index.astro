---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ResearchSection from '../components/ResearchSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ContributionsSection from '../components/ContributionsSection.astro';
import ReleasesSection from '../components/ReleasesSection.astro';
import RepositoriesSection from '../components/RepositoriesSection.astro';
import { loadGithubData } from '../lib/github-data.ts';
import { renderMarkdown } from '../lib/markdown.ts';
import { mergeGroups, mergeProjects, mergeReleases } from '../lib/merge.ts';

// Curated YAML (content collections) merged with the fetched GitHub snapshots.
const data = loadGithubData();
const projectsRaw = (await getCollection('projects')).map((e) => e.data);
const projects = mergeProjects(projectsRaw, data.repos, data.releases, data.projectMeta);
const groups = mergeGroups((await getCollection('groups')).map((e) => e.data), data.repos);
const research = (await getCollection('research')).map((e) => e.data);
// The release feed is news: only releases of the last twelve months.
const since = new Date(new Date(data.releases.fetchedAt).getTime() - 365 * 86400000).toISOString();
const releases = mergeReleases(projectsRaw, data.releases, renderMarkdown, since);
const projectChips = projects.map((p) => ({ id: p.id, name: p.name }));
---
<Base title="Prof. Dr. Matthias König – software & research software engineering" fetchedAt={data.repos.fetchedAt}>
  <Hero />
  <main class="flex-1">
    <ResearchSection items={research} />
    <ProjectsSection projects={projects} />
    <ContributionsSection stats={data.stats} contributions={data.contributions} />
    <ReleasesSection releases={releases} projects={projectChips} />
    <RepositoriesSection groups={groups} />
  </main>
</Base>
