---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ResearchSection from '../components/ResearchSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ContributionsSection from '../components/ContributionsSection.astro';
import ReleasesSection from '../components/ReleasesSection.astro';
import RepositoriesSection from '../components/RepositoriesSection.astro';
import { loadGithubData } from '../lib/github-data.ts';
import { renderMarkdown, summarizeMarkdown } from '../lib/markdown.ts';
import { mergeGroups, mergeProjects, mergeReleases, releaseSources } from '../lib/merge.ts';
import { chartExclusions, releaseTimeline, starsByRepo } from '../lib/charts.ts';
import { logoUrls } from '../lib/logos.ts';

// Curated YAML (content collections) merged with the fetched GitHub snapshots.
const data = loadGithubData();
const projectsRaw = (await getCollection('projects')).map((e) => e.data);
const projects = mergeProjects(projectsRaw, data.repos, data.releases, data.projectMeta);
const groups = mergeGroups((await getCollection('groups')).map((e) => e.data), data.repos);
const research = (await getCollection('research')).map((e) => e.data);
// Release feed: the latest release of every repository on the page, from the last two years.
const since = new Date(new Date(data.releases.fetchedAt).getTime() - 2 * 365 * 86400000).toISOString();
const sources = releaseSources(projectsRaw, groups);
const releases = mergeReleases(sources, data.releases, renderMarkdown, summarizeMarkdown, since);
const excluded = chartExclusions(groups);
const timeline = releaseTimeline(sources, data.releases, excluded);
const stars = starsByRepo(data.repos.repos, 15, excluded);
const logos = await logoUrls(Object.keys(data.repos.repos), projectsRaw);
const releasesWithLogos = releases.map((r) => ({ ...r, logo: logos[r.repo] ?? null }));
const groupsWithLogos = groups.map((g) => ({ ...g, entries: g.entries.map((e) => ({ ...e, logo: logos[e.fullName] ?? null })) }));
---
<Base title="Prof. Dr. Matthias König – software & research software engineering" fetchedAt={data.repos.fetchedAt}>
  <Hero />
  <main class="flex-1">
    <ResearchSection items={research} />
    <ProjectsSection projects={projects} topics={research} />
    <ContributionsSection stats={data.stats} contributions={data.contributions} />
    <ReleasesSection releases={releasesWithLogos} timeline={timeline} />
    <RepositoriesSection groups={groupsWithLogos} stars={stars} />
  </main>
</Base>
